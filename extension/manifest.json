{
    "name": "Proxy ON/OFF Button",
    "description": "Proxy ON/OFF Button for chrome extension.",
    "version": "0.2",
    "manifest_version": 3,
    "author": "betarium",
    "homepage_url": "https://github.com/betarium/proxy-on-off-button-chrome-extension",
    "icons": {
        "16": "icons/icon16.png"
    },
    "permissions": [
        "proxy",
        "storage",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {},
    "options_page": "options.html"
}